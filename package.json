{
  "name": "delulu-talks",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "description": "Private, local-first system-wide dictation with CPU, CUDA and MLX speech models",
  "author": {
    "name": "JoranEMostert",
    "email": "92588849+JoranEMostert@users.noreply.github.com"
  },
  "repository": "https://github.com/JEMostert/delulu-talks.git",
  "license": "MIT",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "build": "bun run typecheck && tauri build",
    "build:web": "vite build",
    "tauri": "tauri",
    "preview:web": "vite preview",
    "test": "bun run test:unit && bun run test:python && bun run test:rust",
    "test:e2e": "playwright test",
    "backup:dry-run": "node scripts/backup-restore-dry-run.mjs",
    "format": "prettier --write src tests scripts/*.mjs playwright.config.ts vite.config.ts",
    "format:check": "prettier --check src tests scripts/*.mjs playwright.config.ts vite.config.ts",
    "test:python": "bun scripts/python-unit-tests.mjs",
    "test:unit": "bun test ./src ./tests/unit",
    "test:rust": "cd src-tauri && cargo test --workspace"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "7.3.6"
  }
}
