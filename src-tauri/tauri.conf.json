{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delulu Talks",
  "mainBinaryName": "delulu-talks",
  "version": "../package.json",
  "identifier": "com.joran.delulu-talks",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:web && bun run build:helper",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Delulu Talks",
        "width": 900,
        "height": 640,
        "minWidth": 640,
        "minHeight": 520,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libvulkan1"
        ],
        "desktopTemplate": "linux/generated.desktop",
        "files": {
          "/usr/share/applications/com.joran.delulu-talks.desktop": "linux/com.joran.delulu-talks.desktop",
          "/usr/lib/delulu-talks/delulu-cleanup": "../target/release/delulu-cleanup"
        }
      },
      "rpm": {
        "depends": [
          "vulkan-loader"
        ],
        "desktopTemplate": "linux/generated.desktop",
        "files": {
          "/usr/share/applications/com.joran.delulu-talks.desktop": "linux/com.joran.delulu-talks.desktop",
          "/usr/lib/delulu-talks/delulu-cleanup": "../target/release/delulu-cleanup"
        }
      }
    }
  }
}
