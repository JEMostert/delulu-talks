{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delulu Talks",
  "mainBinaryName": "delulu-talks",
  "version": "../package.json",
  "identifier": "com.joran.delulu-talks",
  "build": {
    "beforeDevCommand": "bun run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build:web && bun run build:engine && bun run build:pill && bun run build:voice",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Delulu Talks",
        "width": 1180,
        "height": 760,
        "minWidth": 980,
        "minHeight": 620,
        "visible": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libvulkan1",
          "minisign"
        ],
        "desktopTemplate": "linux/generated.desktop",
        "files": {
          "/usr/share/applications/com.joran.delulu-talks.desktop": "linux/com.joran.delulu-talks.desktop",
          "/usr/lib/delulu-talks/delulu-engine": "../target/release/delulu-engine",
          "/usr/lib/delulu-talks/delulu-pill": "../target/release/delulu-pill",
          "/usr/bin/delulu": "../target/release/delulu",
          "/usr/libexec/delulu-talks/install-update": "../packaging/install-update",
          "/usr/libexec/delulu-talks/updater.pub": "../packaging/updater.pub"
        }
      },
      "rpm": {
        "depends": [
          "vulkan-loader",
          "minisign"
        ],
        "desktopTemplate": "linux/generated.desktop",
        "files": {
          "/usr/share/applications/com.joran.delulu-talks.desktop": "linux/com.joran.delulu-talks.desktop",
          "/usr/lib/delulu-talks/delulu-engine": "../target/release/delulu-engine",
          "/usr/lib/delulu-talks/delulu-pill": "../target/release/delulu-pill",
          "/usr/bin/delulu": "../target/release/delulu",
          "/usr/libexec/delulu-talks/install-update": "../packaging/install-update",
          "/usr/libexec/delulu-talks/updater.pub": "../packaging/updater.pub"
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwRTFDOEYyM0JCNDk3MjkKUldRcGw3UTc4c2poY0NxWmFWRDdhamZ4QlIvMFZra0loc3hVaTZvMFVaOVl2NUZOM0swci9hb0YK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/JEMostert/delulu-talks/releases/latest/download/latest.json"
      ]
    }
  }
}
