{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Delulu Talks",
  "version": "1.0.0",
  "identifier": "com.joran.delulu-talks",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Delulu Talks",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 640,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "python/transcription_engine.py",
      "resources/sounds/HANDY_LICENSE.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
