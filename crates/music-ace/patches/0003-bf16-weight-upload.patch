+            size_t count = pc.nbytes / sizeof(*src);
+            for (size_t i = 0; i < count;) {
+                converted.resize(std::min<size_t>(count - i, 65536));
+                for (size_t j = 0; j < converted.size(); ++j) {
+                    converted[j] = ggml_fp32_to_fp16(ggml_bf16_to_fp32(src[i + j]));
