# Delulu Talks daemon, as a systemd user service.
#
# Not installed or enabled by any package yet. The final unit name depends on
# how the desktop portals identify a systemd service (work package B2), and the
# binary becomes /usr/bin/delulu once it absorbs the voice CLI (D3).
#
# Try it by hand:
#   cp packaging/systemd/delulu.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user start delulu
#   journalctl --user -u delulu -f

[Unit]
Description=Delulu Talks daemon
Documentation=https://github.com/JEMostert/delulu-talks
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/delulud daemon
# The daemon removes its socket on SIGTERM; systemd reaps engine workers with it.
KillMode=control-group
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
